{
  "name": "fosicons.com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Fos Icons website: search, customize, and export icons.",
  "scripts": {
    "sync": "node scripts/sync-icons.mjs",
    "sync:check": "node scripts/sync-icons.mjs --check",
    "dev": "vite",
    "build": "pnpm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/postbuild.mjs",
    "check:hydration": "node scripts/check-hydration.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "node ./node_modules/typescript7/bin/tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm run sync:check && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.28.9",
  "dependencies": {
    "@fontsource-variable/asta-sans": "^5.3.0",
    "@fontsource-variable/funnel-display": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/analytics": "^2.0.1",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "highlight.js": "11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "10.6.9",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright": "1.65.1",
    "storybook": "10.6.9",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "typescript7": "npm:typescript@~7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
