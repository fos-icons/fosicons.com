{
  "name": "fosicons.com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Fos Icons website: search, customize, and export icons.",
  "scripts": {
    "sync": "node scripts/sync-icons.mjs",
    "sync:check": "node scripts/sync-icons.mjs --check",
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/postbuild.mjs",
    "check:hydration": "node scripts/check-hydration.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm run sync:check && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.28.9",
  "dependencies": {
    "@fontsource-variable/asta-sans": "^5.3.0",
    "@fontsource-variable/funnel-display": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/analytics": "^2.0.1",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "highlight.js": "11.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "playwright": "1.63.0",
    "storybook": "10.6.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
