# Copy to .env.local for local testing. Do not enable these in production.
BILLING_SANDBOX_ENABLED=false
VITE_BILLING_SANDBOX_ENABLED=false
BILLING_SITE_URL=http://localhost:5173

# Use a dedicated Supabase project for sandbox testers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe sandbox only. The webhook signing secret is endpoint-specific.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_COUPON_ID=
STRIPE_ADVANCED_PRICE_ID=
STRIPE_ADVANCED_COUPON_ID=
# Optional. Omit to use the sandbox account's default portal configuration.
STRIPE_PORTAL_CONFIGURATION_ID=
