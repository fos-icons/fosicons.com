# Copy to .env.local for local testing with BILLING_MODE=sandbox.
# `sandbox`: the Polar sandbox (sandbox.polar.sh), never on Vercel production.
# `live`: real payments on polar.sh, Vercel production only (set there, not in .env.local).
# Leave both unset to keep billing off. See README "Billing (Polar)".
BILLING_MODE=
VITE_BILLING_MODE=
BILLING_SITE_URL=http://localhost:5173

# Use a separate Supabase project for each mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Polar organization access token (polar_oat_…). Sandbox and production tokens are separate.
POLAR_ACCESS_TOKEN=
# Signing secret of the webhook endpoint that points at /api/billing/webhook.
POLAR_WEBHOOK_SECRET=
# Product and discount IDs (UUIDs) from the same Polar environment as the token.
POLAR_PRO_PRODUCT_ID=
POLAR_PRO_DISCOUNT_ID=
POLAR_ADVANCED_PRODUCT_ID=
POLAR_ADVANCED_DISCOUNT_ID=
