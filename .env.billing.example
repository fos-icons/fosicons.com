# Copy to .env.local for local testing with BILLING_MODE=sandbox.
# `sandbox`: Stripe test mode, never on Vercel production.
# `live`: real payments, Vercel production only (set there, not in .env.local).
# Leave both unset to keep billing off. See README "Billing (Stripe)".
BILLING_MODE=
VITE_BILLING_MODE=
BILLING_SITE_URL=http://localhost:5173

# Use a separate Supabase project for each mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# sk_test_ keys for sandbox, sk_live_ keys for live. The webhook signing secret is endpoint-specific.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_COUPON_ID=
STRIPE_ADVANCED_PRICE_ID=
STRIPE_ADVANCED_COUPON_ID=
# Optional. Omit to use the Stripe account's default portal configuration.
STRIPE_PORTAL_CONFIGURATION_ID=
